---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site, path } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  jsonLd?: object;
}

const {
  title,
  description = 'Abogada en Santiago especializada en Derecho de Familia: divorcios, pensión de alimentos, custodia y violencia intrafamiliar. Atención personalizada y honorarios transparentes.',
  ogImage = '/og-default.jpg',
  jsonLd,
} = Astro.props;

const fullTitle = title
  ? `${title} | ${site.fullName} — Abogada`
  : `${site.fullName} — Abogada de Familia en Santiago`;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://nataliavallejos.cl').toString();

const baseJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: site.fullName,
  description,
  url: canonical,
  areaServed: { '@type': 'Country', name: 'Chile' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Santiago',
    addressCountry: 'CL',
  },
  founder: {
    '@type': 'Person',
    name: site.fullName,
    jobTitle: 'Abogada',
    alumniOf: site.university,
  },
};
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={path('/favicon.svg')} />
    <link rel="canonical" href={canonical} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_CL" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0e2a47" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? baseJsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />

    <!-- Event beacon → /api/track (Cloudflare Function). Fire-and-forget, bots
         excluded server-side. Tracks page_view on load plus WhatsApp and
         contact-info clicks site-wide (delegated). Skips localhost, the GitHub
         Pages mirror, and the gated /admin pages. -->
    <script is:inline>
      (function () {
        try {
          var h = location.hostname;
          if (/localhost|127\.|0\.0\.0\.0|github\.io/.test(h)) return;

          function track(type, path) {
            try {
              var payload = JSON.stringify({ type: type, path: path || location.pathname });
              if (navigator.sendBeacon) {
                navigator.sendBeacon('/api/track', payload);
              } else {
                fetch('/api/track', { method: 'POST', body: payload, keepalive: true });
              }
            } catch (e) {}
          }

          if (location.pathname.indexOf('/admin') !== 0) {
            track('page_view', location.pathname);
          }

          document.addEventListener(
            'click',
            function (e) {
              var a = e.target && e.target.closest ? e.target.closest('a') : null;
              if (!a) return;
              var href = a.getAttribute('href') || '';
              if (/wa\.me|api\.whatsapp\.com|whatsapp/i.test(href)) {
                track('whatsapp_btn_click', href);
              } else if (/^mailto:|^tel:/i.test(href)) {
                track('contact_info_click', href);
              }
            },
            true
          );
        } catch (e) {}
      })();
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--navy);
        color: var(--cream);
        padding: 8px 16px;
        z-index: 200;
      }
      .skip-link:focus {
        left: 16px;
        top: 16px;
      }
    </style>
  </body>
</html>
