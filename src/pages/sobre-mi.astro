---
import Base from '../layouts/Base.astro';
import { site, whatsappLink } from '../data/site';

const values = [
  {
    title: 'Cercanía',
    text: 'Atiendo personalmente cada caso. No te atenderá un asistente: me tendrás a mí en cada audiencia y en cada conversación.',
  },
  {
    title: 'Transparencia',
    text: 'Honorarios fijos, presupuesto por escrito antes de comenzar y reportes del avance en cada etapa.',
  },
  {
    title: 'Confidencialidad',
    text: 'Todo lo que compartes conmigo está amparado por el secreto profesional.',
  },
  {
    title: 'Realismo',
    text: 'Te diré las posibilidades reales de tu caso —las buenas y las difíciles— para que decidas con información.',
  },
];
---

<Base
  title="Sobre mí"
  description="Conoce a Natalia Vallejos Gutiérrez, abogada en Santiago especializada en Derecho de Familia, violencia intrafamiliar y derechos humanos. Trayectoria, formación y enfoque profesional."
>
  <!-- INTRO + BIO -->
  <section class="section">
    <div class="container about-grid">
      <div class="about-photo">
        <!-- TODO: reemplazar por foto profesional de Natalia -->
        <div class="photo-placeholder" aria-hidden="true">
          <span class="photo-mark">NV</span>
          <span class="photo-caption">Natalia Vallejos · Abogada</span>
        </div>
      </div>

      <div class="about-text">
        <span class="eyebrow">Sobre mí</span>
        <h1>Hola, soy Natalia Vallejos.</h1>
        <p class="lead">
          Abogada y litigante en Derecho de Familia. Acompaño a personas y
          familias en los procesos que tocan lo más íntimo de su vida, con una
          asesoría cercana, técnica y honesta.
        </p>

        <p>
          Trabajo separaciones, pensiones de alimentos, cuidado personal y
          situaciones de violencia intrafamiliar. Elegí estas materias porque
          detrás de cada expediente hay una persona tomando una de las
          decisiones más importantes de su vida, y merece ser escuchada y bien
          representada.
        </p>
        <p>
          Mi experiencia se forjó en tribunales reales. En mi práctica en la
          <strong>Corporación de Asistencia Judicial</strong> tramité 103
          causas en Tribunales de Familia y logré el cierre efectivo de 62, con
          calificación 6,9/7,0. Antes, en el <strong>SernamEG, Centro de la
          Mujer de Quilicura</strong>, representé a víctimas de violencia
          intrafamiliar coordinando directamente con la Fiscalía.
        </p>
        <p>
          Hoy ejerzo de forma independiente y atiendo a clientes de toda la
          Región Metropolitana y del resto de Chile por videoconferencia.
          Complemento mi práctica con un Diplomado en Gobierno Corporativo y
          Compliance en la Universidad de Chile.
        </p>
      </div>
    </div>
  </section>

  <!-- CÓMO TRABAJO -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Cómo trabajo</span>
        <h2>Mi forma de acompañarte</h2>
      </div>

      <div class="grid grid-4 values">
        {values.map((v) => (
          <div class="value-card">
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FORMACIÓN -->
  <section class="section section--cream-warm">
    <div class="container container--narrow">
      <div class="section-head">
        <span class="eyebrow">Formación y credenciales</span>
        <h2>Mi formación</h2>
      </div>

      <ul class="formacion">
        <li>
          <strong>{site.degree}</strong>
          <span>{site.university}</span>
        </li>
        <li>
          <strong>Abogada habilitada ante la Excma. Corte Suprema</strong>
          <span>Habilitada para litigar en todo Chile</span>
        </li>
        <li>
          <strong>Diplomado en Gobierno Corporativo y Compliance</strong>
          <span>Universidad de Chile, Facultad de Derecho · en curso</span>
        </li>
        <li>
          <strong>Litigio Estratégico Comunitario</strong>
          <span>Escuela Latinoamericana de Abogacía Comunitaria y Activismo Jurídico, 2025</span>
        </li>
        <li>
          <strong>Verificación pública</strong>
          <span>
            Puedes verificar mi habilitación en el
            <a href="https://www.pjud.cl/" target="_blank" rel="noopener noreferrer">Buscador del Poder Judicial</a>.
          </span>
        </li>
      </ul>

      <div class="formacion-cta">
        <a class="btn btn-gold" href={whatsappLink()} target="_blank" rel="noopener">
          Hablemos por WhatsApp
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    align-items: start;
  }

  .photo-placeholder {
    aspect-ratio: 4 / 5;
    background: radial-gradient(circle at 30% 20%, var(--navy-soft), var(--navy) 60%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--gold);
    font-family: var(--serif);
    box-shadow: var(--shadow-md);
    position: sticky;
    top: 100px;
    border: 1px solid var(--gold);
  }

  .photo-mark { font-size: 5rem; font-weight: 600; line-height: 1; }
  .photo-caption {
    color: var(--cream);
    opacity: 0.55;
    font-family: var(--sans);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-top: 16px;
  }

  .about-text h1 { margin-top: 4px; }

  /* Values */
  .section-head {
    margin-bottom: 40px;
    max-width: 640px;
  }

  .value-card {
    background: white;
    border: 1px solid var(--border);
    padding: 28px;
  }

  .value-card h3 {
    font-size: 1.3rem;
    margin-bottom: 10px;
  }

  .value-card p {
    color: var(--muted);
    font-size: 0.94rem;
    margin: 0;
  }

  /* Formación */
  .formacion {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .formacion li {
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
    display: grid;
    gap: 4px;
  }

  .formacion li:last-child { border-bottom: 0; }

  .formacion strong {
    color: var(--navy);
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .formacion span {
    color: var(--muted);
    font-size: 0.94rem;
  }

  .formacion-cta {
    margin-top: 32px;
  }

  @media (max-width: 800px) {
    .about-grid { grid-template-columns: 1fr; gap: 36px; }
    .photo-placeholder { position: static; max-width: 320px; margin-inline: auto; width: 100%; }
  }

  /* Phones: shrink the placeholder to a small monogram avatar so it doesn't
     push the bio below the fold (it's just a placeholder until there's a photo). */
  @media (max-width: 600px) {
    .about-grid { gap: 18px; }
    .photo-placeholder { aspect-ratio: 1 / 1; max-width: 116px; }
    .photo-mark { font-size: 2.2rem; }
    .photo-caption { display: none; }
  }
</style>
