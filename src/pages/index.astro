---
import Base from '../layouts/Base.astro';
import { whatsappLink, path } from '../data/site';
import { getFeaturedServices } from '../data/services';
import Icon from '../components/Icon.astro';

const featured = getFeaturedServices();

const faqs = [
  {
    q: '¿Cuánto demora un divorcio en Chile?',
    a: 'Un divorcio de mutuo acuerdo se resuelve en 2 a 4 meses desde la presentación. Un divorcio unilateral, entre 6 y 12 meses dependiendo de la complejidad y la carga del tribunal.',
  },
  {
    q: '¿Atiende online o solo presencial?',
    a: 'Atiendo principalmente por videollamada, lo que me permite representar a clientas y clientes de toda la Región Metropolitana y del resto de Chile —las audiencias en Tribunales de Familia hoy son mayoritariamente por Zoom. La primera consulta también se realiza por videollamada para tu comodidad.',
  },
  {
    q: '¿Cuánto cuesta una primera consulta?',
    a: 'La primera consulta tiene un valor referencial de $15.000 (60 minutos). En casos de violencia intrafamiliar la primera orientación es siempre gratuita.',
  },
  {
    q: '¿Aceptan pago en cuotas?',
    a: 'Sí, los honorarios pueden pagarse hasta en 3 cuotas sin interés con tarjeta de crédito o transferencia bancaria.',
  },
  {
    q: '¿Qué pasa si la otra parte vive fuera de Chile?',
    a: 'Existen mecanismos de notificación internacional (cartas rogatorias, exhortos por Convención de La Haya) que permiten avanzar igualmente. Tengo experiencia en estos casos.',
  },
  {
    q: '¿Es obligatoria la mediación previa?',
    a: 'Sí, en materias de pensión de alimentos, cuidado personal y régimen de relación directa y regular la mediación familiar es obligatoria antes de demandar. Yo te acompaño durante todo el proceso.',
  },
];
---

<Base
  title="Asesoría legal en Derecho de Familia"
  description="Abogada en Santiago especializada en divorcios, pensión de alimentos, custodia de niños y violencia intrafamiliar. Honorarios transparentes y atención personalizada."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-inner">
        <!-- <span class="ornament" aria-hidden="true">
          <span class="diamond"></span>
        </span>
        <span class="hero-eyebrow">Abogada en Derecho de Familia</span> -->

        <h1 class="hero-title">
          Asesoría legal con <span class="italic-gold">cercanía</span> y <span class="italic-gold">compromiso</span>.
        </h1>
        <br>

        <!-- <span class="ornament ornament-sm" aria-hidden="true">
          <span class="diamond"></span>
        </span> -->

        <p class="hero-lead">
          Acompaño a personas y familias en momentos importantes,
          entregando soluciones jurídicas <span class="emph-gold">claras, humanas y efectivas</span> en cada etapa.
        </p>
        <br>

        <ul class="hero-areas" aria-label="Áreas principales">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
              <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
              <path d="M7 21h10"/><path d="M12 3v18"/>
              <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
            </svg>
            <span>Divorcios</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="8" cy="8" r="6"/>
              <path d="M18.09 10.37A6 6 0 1 1 10.34 18"/>
              <path d="M7 6h1v4"/>
              <path d="m16.71 13.88.71.71-2.83 2.83"/>
            </svg>
            <span>Pensión de<br/>alimentos</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <span>Custodia y<br/>cuidado personal</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
            </svg>
            <span>Violencia<br/>intrafamiliar</span>
          </li>
        </ul>

        <br>
        <div class="hero-ctas">
          <a class="btn btn-primary" href={whatsappLink()} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
            Conversemos por WhatsApp
          </a>
        </div>

        <p class="hero-reassurance">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
          Atención confidencial, cercana y con enfoque en soluciones.
        </p>
    </div>
  </section>

  <!-- REASSURANCE BAR -->
  <section class="reassure-bar">
    <div class="container reassure-grid">
      <div class="reassure-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="6" y1="3" x2="6" y2="21"/>
          <line x1="18" y1="3" x2="18" y2="21"/>
          <line x1="3" y1="3" x2="21" y2="3"/>
          <line x1="3" y1="21" x2="21" y2="21"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="9" y1="6" x2="9" y2="21"/>
          <line x1="15" y1="6" x2="15" y2="21"/>
        </svg>
        <div>
          <h4>Experiencia y especialización</h4>
          <p>Práctica concreta en Tribunales de Familia y casos de VIF.</p>
        </div>
      </div>

      <div class="reassure-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <div>
          <h4>Atención personalizada</h4>
          <p>Trato directo con la abogada en cada etapa.</p>
        </div>
      </div>

      <div class="reassure-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
        <div>
          <h4>Orientación clara</h4>
          <p>Información transparente y estrategias efectivas.</p>
        </div>
      </div>

      <div class="reassure-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <div>
          <h4>Santiago, Chile</h4>
          <p>Atención online y presencial.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES GRID -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Servicios</span>
        <h2>Cómo puedo ayudarte</h2>
        <p class="lead">
          Mis servicios cubren las principales materias del Derecho de
          Familia, además de recursos contra Isapres y registro de marcas.
          Cada caso recibe una propuesta de honorarios clara y por escrito.
        </p>
      </div>

      <div class="grid grid-3 services">
        {featured.map((s) => (
          <a class="service-card" href={path(`/servicios/${s.slug}`)}>
            <span class="service-icon" aria-hidden="true"><Icon name={s.icon} size={26} /></span>
            <h3>{s.shortTitle ?? s.title}</h3>
            <p>{s.summary}</p>
            <span class="service-price">{s.priceRange}</span>
            <span class="service-link">Conoce más →</span>
          </a>
        ))}
      </div>

      <div class="text-center" style="margin-top: 40px;">
        <a class="btn btn-outline" href={path('/servicios')}>Ver todos los servicios</a>
      </div>
    </div>
  </section>

  <!-- HOW I WORK -->
  <section class="section section--cream-warm">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Mi proceso</span>
        <h2>Cómo trabajo contigo</h2>
      </div>

      <div class="grid grid-4 steps">
        <div class="step">
          <span class="step-num">01</span>
          <h4>Conversamos</h4>
          <p>Me escribes por WhatsApp o agendamos una primera consulta de 60 minutos para entender tu situación.</p>
        </div>
        <div class="step">
          <span class="step-num">02</span>
          <h4>Análisis del caso</h4>
          <p>Reviso los antecedentes, te explico tus opciones legales con claridad y te entrego una propuesta de honorarios fija por escrito.</p>
        </div>
        <div class="step">
          <span class="step-num">03</span>
          <h4>Definimos estrategia</h4>
          <p>Acordamos juntas la estrategia más conveniente para tus objetivos. Confirmas y firmamos el mandato.</p>
        </div>
        <div class="step">
          <span class="step-num">04</span>
          <h4>Te represento</h4>
          <p>Asumo la representación, presento las acciones que correspondan y te informo del avance en cada etapa.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container container--narrow">
      <div class="section-head text-center">
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2>Resolviendo tus dudas</h2>
      </div>

      <div class="faqs">
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section section--navy">
    <div class="container final-cta">
      <h2>¿Necesitas orientación? Hablemos hoy mismo.</h2>
      <p class="lead" style="color: var(--cream); opacity: 0.9;">
        Te respondo personalmente. La primera consulta es de 60 minutos y
        te entrega claridad sobre tus opciones legales.
      </p>
      <div class="hero-ctas" style="justify-content: center;">
        <a class="btn btn--on-navy" href={whatsappLink()} target="_blank" rel="noopener">
          Conversemos por WhatsApp
        </a>
        <a class="btn btn-outline--on-navy" href={path('/contacto')}>Más formas de contacto</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(12px, 1.7vw, 23px);
    background: var(--cream);
  }

  .hero-inner {
    max-width: 1160px;
    margin-inline: auto;
    text-align: center;
  }

  .hero-eyebrow {
    display: inline-block;
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--gold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-left: 16px;
    vertical-align: middle;
  }

  .hero-title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(2.4rem, 5vw, 4.8rem);
    line-height: 1.06;
    color: var(--navy);
    margin: 12px auto 14px;
    letter-spacing: -0.005em;
  }

  .hero-lead {
    font-family: var(--sans);
    font-size: 1.05rem;
    line-height: 1.55;
    color: #4a4a4a;
    max-width: 62ch;
    margin: 16px auto 26px;
  }

  .emph-gold {
    color: var(--gold);
    font-weight: 500;
  }

  .ornament {
    color: var(--gold);
  }

  .ornament-sm::before, .ornament-sm::after {
    width: 18px;
  }

  /* Hero areas (4 small pills) */
  .hero-areas {
    list-style: none;
    margin: 0 auto 24px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 18px 48px;
    align-items: center;
  }

  .hero-areas li {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
  }

  .hero-areas svg {
    width: 26px;
    height: 26px;
    color: var(--gold);
    flex-shrink: 0;
  }

  .hero-areas span {
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--navy);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .hero-ctas {
    display: flex;
    gap: 12px;
    margin-top: 4px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-reassurance {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .hero-reassurance svg {
    width: 18px;
    height: 18px;
    color: var(--gold);
    flex-shrink: 0;
  }

  /* Reassurance bar (4-up) */
  .reassure-bar {
    background: var(--cream-warm);
    border-block: 1px solid var(--border);
    padding: 26px 0;
  }

  .reassure-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 36px;
  }

  .reassure-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .reassure-item svg {
    width: 36px;
    height: 36px;
    color: var(--gold);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .reassure-item h4 {
    font-family: var(--sans);
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--navy);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 6px;
  }

  .reassure-item p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .reassure-grid { grid-template-columns: repeat(2, 1fr); gap: 28px; }
  }

  @media (max-width: 540px) {
    .reassure-grid { grid-template-columns: 1fr; gap: 20px; }
  }

  /* Section heading */
  .section-head {
    margin-bottom: 48px;
    max-width: 700px;
  }

  .section-head.text-center {
    margin-inline: auto;
  }

  /* Services grid */
  .service-card {
    display: flex;
    flex-direction: column;
    background: white;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    transition: border-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
    border-bottom: 1px solid var(--border) !important;
    color: var(--charcoal);
  }

  .service-card:hover {
    border-color: var(--gold) !important;
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .service-icon {
    margin-bottom: 16px;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--cream-warm);
    color: var(--gold);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .service-card h3 {
    margin-bottom: 8px;
  }

  .service-card p {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 16px;
    flex-grow: 1;
  }

  .service-price {
    display: inline-block;
    color: var(--navy);
    font-weight: 600;
    font-size: 0.92rem;
    margin-bottom: 8px;
  }

  .service-link {
    color: var(--gold);
    font-weight: 500;
    font-size: 0.92rem;
  }

  /* Steps */
  .steps {
    margin-top: 16px;
  }

  .step {
    background: white;
    border-radius: var(--radius-lg);
    padding: 28px;
    border: 1px solid var(--border);
  }

  .step-num {
    display: inline-block;
    color: var(--gold);
    font-family: var(--serif);
    font-size: 1.6rem;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .step h4 {
    margin-bottom: 8px;
  }

  .step p {
    color: var(--muted);
    font-size: 0.94rem;
    margin: 0;
  }

  /* FAQ */
  .faqs {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .faq {
    background: white;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0;
    overflow: hidden;
  }

  .faq summary {
    padding: 18px 24px;
    cursor: pointer;
    font-weight: 500;
    font-size: 1.02rem;
    color: var(--navy);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq summary::-webkit-details-marker { display: none; }

  .faq summary::after {
    content: '+';
    color: var(--gold);
    font-family: var(--serif);
    font-size: 1.6rem;
    line-height: 1;
    transition: transform 200ms ease;
  }

  .faq[open] summary::after {
    transform: rotate(45deg);
  }

  .faq p {
    padding: 0 24px 20px;
    margin: 0;
    color: var(--muted);
  }

  /* Final CTA */
  .final-cta {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
  }

  .final-cta h2 {
    margin-bottom: 16px;
  }
</style>
