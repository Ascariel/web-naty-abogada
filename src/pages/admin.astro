---
// Internal analytics dashboard. Access is gated by functions/_middleware.ts
// (HTTP Basic Auth: admin / ADMIN_PASSWORD). Standalone — does not use Base.astro.
// Data comes from /api/stats. A global metric toggle (Únicas / Totales, default
// Únicas) drives every line chart; the KPI cards show both. A pie chart breaks
// down unique page_view visits by page.
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <title>Estadísticas — Admin</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js" defer></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/es.js" defer></script>
  </head>
  <body>
    <div class="page">
      <header class="page-head">
        <div class="head-main">
          <div class="title-line">
            <h1>Estadísticas</h1>
            <span class="badge"><span class="badge-dot"></span>tranquilidadlegal.cl</span>
          </div>
          <p class="sub">Eventos registrados en el sitio · bots excluidos</p>
        </div>
        <div class="metric">
          <span class="metric-label">Mostrar en gráficos</span>
          <div class="seg" id="metric-seg" role="group" aria-label="Métrica">
            <button type="button" data-m="unique" class="is-active">Únicas</button>
            <button type="button" data-m="total">Totales</button>
          </div>
        </div>
      </header>

      <div class="toolbar">
        <div class="field">
          <label for="from">Desde</label>
          <input type="date" id="from" />
        </div>
        <div class="field">
          <label for="to">Hasta</label>
          <input type="date" id="to" />
        </div>
        <div class="field">
          <label>Agrupar</label>
          <div class="seg" id="seg" role="group" aria-label="Agrupar por">
            <button type="button" data-g="day" class="is-active">Día</button>
            <button type="button" data-g="week">Semana</button>
            <button type="button" data-g="month">Mes</button>
          </div>
        </div>
        <button type="button" class="btn-apply" id="apply">Aplicar</button>
        <span class="status" id="status" aria-live="polite"></span>
      </div>

      <section class="kpis" id="kpis"></section>

      <section class="charts" id="charts"></section>
      <p class="empty card" id="empty" hidden>Sin datos en este rango.</p>
    </div>

    <script is:inline>
      (function () {
        const $ = (id) => document.getElementById(id);
        const fmt = (n) => new Intl.NumberFormat('es-CL').format(n);
        const isoLocal = (d) => {
          const z = new Date(d.getTime() - d.getTimezoneOffset() * 60000);
          return z.toISOString().slice(0, 10);
        };

        const EVENT_META = {
          page_view: { label: 'Vistas de página', color: '#2563eb' },
          whatsapp_btn_click: { label: 'Clics WhatsApp', color: '#16a34a' },
          contact_info_click: { label: 'Clics datos de contacto', color: '#d4a13c' },
        };
        const FALLBACK = ['#7c3aed', '#0891b2', '#dc2626', '#4f46e5', '#db2777', '#65a30d'];
        const meta = (t, i) => EVENT_META[t] || { label: t, color: FALLBACK[i % FALLBACK.length] };

        // Title-case for graph labels/legends. Uppercases each word's first
        // letter (preserving the rest, so "WhatsApp"/"VIF" survive) and keeps
        // Spanish connectors lowercase unless they're the first word.
        const MINOR = new Set(['de','del','la','el','los','las','y','e','o','u','en','a','al','por','para','con','un','una']);
        function titleCase(s) {
          return String(s)
            .split(' ')
            .map((w, i) => {
              if (!w) return w;
              if (i > 0 && MINOR.has(w.toLowerCase())) return w.toLowerCase();
              return w.charAt(0).toUpperCase() + w.slice(1);
            })
            .join(' ');
        }

        // Friendly page names for the pie chart legend.
        const PAGE_LABELS = {
          '/': 'Inicio',
          '/sobre-mi': 'Sobre mí',
          '/areas-de-practica': 'Áreas de práctica',
          '/contacto': 'Contacto',
          '/privacidad': 'Privacidad',
        };
        function pageLabel(path) {
          if (PAGE_LABELS[path]) return PAGE_LABELS[path];
          const seg = path.split('/').filter(Boolean);
          if (!seg.length) return path;
          const last = seg[seg.length - 1].replace(/-/g, ' ');
          return last.charAt(0).toUpperCase() + last.slice(1);
        }
        const PIE_COLORS = [
          '#2563eb', '#16a34a', '#d4a13c', '#7c3aed', '#0891b2',
          '#dc2626', '#db2777', '#65a30d', '#4f46e5', '#ea580c', '#0d9488', '#9333ea',
        ];

        let granularity = 'day';
        let metric = 'unique'; // default: show unique stats
        let lastData = null;
        let charts = [];

        const today = new Date();
        const past = new Date(today.getTime() - 29 * 86400000);
        $('from').value = isoLocal(past);
        $('to').value = isoLocal(today);

        function setChartDefaults() {
          if (!window.Chart) return;
          Chart.defaults.font.family =
            "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif";
          Chart.defaults.font.size = 12;
          Chart.defaults.color = '#6b7280';
        }

        async function load() {
          const from = $('from').value;
          const to = $('to').value;
          $('status').textContent = 'Cargando…';
          try {
            const res = await fetch(`/api/stats?from=${from}&to=${to}&granularity=${granularity}`, {
              headers: { Accept: 'application/json' },
            });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            lastData = await res.json();
          } catch (err) {
            $('status').textContent = 'Error: ' + err.message;
            return;
          }
          $('status').textContent = '';
          render(lastData);
        }

        function renderKpis(data) {
          const wrap = $('kpis');
          if (!data.eventTypes.length) {
            wrap.innerHTML = '<div class="kpi kpi-empty">Sin eventos en este rango.</div>';
            return;
          }
          wrap.innerHTML = data.eventTypes
            .map((t, i) => {
              const m = meta(t, i);
              const tot = data.totals[t] || { total: 0, unique: 0 };
              return `<div class="kpi" style="--c:${m.color}">
                <div class="kpi-top"><span class="kpi-dot"></span><span class="kpi-label">${m.label}</span></div>
                <div class="kpi-num">${fmt(tot.unique)}</div>
                <div class="kpi-meta">únicas (IP·día) · <strong>${fmt(tot.total)}</strong> en total</div>
              </div>`;
            })
            .join('');
        }

        function gradient(ctx, color) {
          const { ctx: c, chartArea } = ctx.chart;
          if (!chartArea) return color + '22';
          const g = c.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
          g.addColorStop(0, color + '38');
          g.addColorStop(1, color + '00');
          return g;
        }

        function lineOptions() {
          return {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            plugins: {
              legend: { display: false },
              tooltip: {
                backgroundColor: '#0f172a', padding: 12, cornerRadius: 10,
                titleColor: '#fff', bodyColor: '#e2e8f0', usePointStyle: true,
                boxPadding: 6, titleFont: { weight: '600' },
              },
            },
            scales: {
              x: { grid: { display: false }, border: { display: false },
                ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 8, color: '#9ca3af' } },
              y: { beginAtZero: true, border: { display: false },
                grid: { color: '#eef1f5', drawTicks: false },
                ticks: { precision: 0, color: '#9ca3af', padding: 10 } },
            },
          };
        }

        function makeLineChart(canvas, color, label, periods, series) {
          const showPoints = periods.length <= 2;
          return new Chart(canvas.getContext('2d'), {
            type: 'line',
            data: {
              labels: periods,
              datasets: [{
                label, data: series, borderColor: color,
                backgroundColor: (c) => gradient(c, color), fill: true,
                tension: 0.35, borderWidth: 2.5,
                pointRadius: showPoints ? 4 : 0, pointHoverRadius: 5,
                pointBackgroundColor: color, pointBorderColor: '#fff', pointBorderWidth: 1.5,
              }],
            },
            options: lineOptions(),
          });
        }

        function makePieChart(canvas, labels, values, colors) {
          return new Chart(canvas.getContext('2d'), {
            type: 'pie',
            data: { labels, datasets: [{ data: values, backgroundColor: colors, borderColor: '#fff', borderWidth: 2 }] },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { position: 'right', labels: { usePointStyle: true, pointStyle: 'circle', boxWidth: 8, padding: 12, color: '#374151' } },
                tooltip: {
                  backgroundColor: '#0f172a', padding: 12, cornerRadius: 10,
                  callbacks: {
                    label: (c) => {
                      const total = c.dataset.data.reduce((a, b) => a + b, 0) || 1;
                      const pct = Math.round((c.parsed / total) * 100);
                      return ` ${c.label}: ${fmt(c.parsed)} (${pct}%)`;
                    },
                  },
                },
              },
            },
          });
        }

        function render(data) {
          renderKpis(data);
          charts.forEach((c) => c.destroy());
          charts = [];

          const wrap = $('charts');
          const hasData = data.periods.length > 0 && data.eventTypes.length > 0;
          $('empty').hidden = hasData;
          wrap.hidden = !hasData;
          wrap.innerHTML = '';
          if (!hasData) return;

          const metricLabel = metric === 'unique' ? 'Únicas' : 'Total';

          // One line chart per event type (shows the toggled metric only).
          data.eventTypes.forEach((t, i) => {
            const m = meta(t, i);
            const tot = data.totals[t] || { total: 0, unique: 0 };
            const card = document.createElement('section');
            card.className = 'card chart-card';
            card.innerHTML = `
              <div class="card-head">
                <div class="ch-title"><span class="ch-dot" style="background:${m.color}"></span><h2>${titleCase(m.label)}</h2></div>
                <div class="ch-meta">${metricLabel} <strong>${fmt(tot[metric])}</strong></div>
              </div>
              <div class="canvas-holder"><canvas></canvas></div>`;
            wrap.appendChild(card);
            charts.push(
              makeLineChart(card.querySelector('canvas'), m.color, metricLabel, data.periods, data.series[t][metric])
            );
          });

          // Pie: page_view visits by page — follows the metric toggle.
          const pages = data.pages || [];
          const valueKey = metric === 'unique' ? 'uniques' : 'total';
          const pageData = pages.filter((p) => p[valueKey] > 0);
          if (pageData.length) {
            const labels = pageData.map((p) => titleCase(pageLabel(p.path)));
            const values = pageData.map((p) => p[valueKey]);
            const colors = pageData.map((_, i) => PIE_COLORS[i % PIE_COLORS.length]);
            const pieMeta = metric === 'unique' ? 'Visitas únicas por página' : 'Visitas totales por página';
            const card = document.createElement('section');
            card.className = 'card chart-card';
            card.innerHTML = `
              <div class="card-head">
                <div class="ch-title"><h2>${titleCase('Páginas visitadas')}</h2></div>
                <div class="ch-meta">${pieMeta}</div>
              </div>
              <div class="canvas-holder"><canvas></canvas></div>`;
            wrap.appendChild(card);
            charts.push(makePieChart(card.querySelector('canvas'), labels, values, colors));
          }
        }

        // Controls
        $('seg').addEventListener('click', (e) => {
          const b = e.target.closest('button');
          if (!b) return;
          granularity = b.dataset.g;
          [...$('seg').children].forEach((c) => c.classList.toggle('is-active', c === b));
          load();
        });
        $('metric-seg').addEventListener('click', (e) => {
          const b = e.target.closest('button');
          if (!b) return;
          metric = b.dataset.m;
          [...$('metric-seg').children].forEach((c) => c.classList.toggle('is-active', c === b));
          if (lastData) render(lastData); // no refetch — data has both metrics
        });
        $('apply').addEventListener('click', load);
        // Fallback for native date inputs if flatpickr fails to load.
        ['from', 'to'].forEach((id) => $(id).addEventListener('change', load));

        function initPickers() {
          if (!window.flatpickr) return;
          if (window.flatpickr.l10ns && window.flatpickr.l10ns.es) {
            flatpickr.localize(window.flatpickr.l10ns.es);
          }
          ['from', 'to'].forEach((id) =>
            flatpickr('#' + id, {
              dateFormat: 'Y-m-d', // value sent to the API
              altInput: true,
              altFormat: 'd/m/Y', // shown to the user: day/month/year
              allowInput: true,
              locale: 'es',
              onChange: () => load(),
            })
          );
        }

        let tries = 0;
        function start() {
          tries++;
          // Need Chart.js; wait up to ~2s for flatpickr, then fall back to native.
          if (window.Chart && (window.flatpickr || tries > 40)) {
            setChartDefaults();
            initPickers();
            load();
          } else {
            setTimeout(start, 50);
          }
        }
        start();
      })();
    </script>

    <style is:global>
      :root {
        --bg: #f4f6f9;
        --card: #ffffff;
        --ink: #0f172a;
        --muted: #6b7280;
        --faint: #9ca3af;
        --line: #e6e9ee;
        --navy: #0e2a47;
        --accent: #2563eb;
        --radius: 16px;
        --shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 4px 16px rgba(16, 24, 40, 0.05);
        --shadow-sm: 0 1px 2px rgba(16, 24, 40, 0.05);
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.5; -webkit-font-smoothing: antialiased;
      }
      .page { max-width: 1080px; margin: 0 auto; padding: 40px 24px 80px; }

      /* Header */
      .page-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; flex-wrap: wrap; margin-bottom: 28px; }
      .title-line { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
      .page-head h1 { margin: 0; font-size: 1.9rem; font-weight: 700; letter-spacing: -0.02em; color: var(--navy); }
      .badge {
        display: inline-flex; align-items: center; gap: 7px; background: #fff;
        border: 1px solid var(--line); padding: 5px 11px; border-radius: 999px;
        font-size: 0.78rem; font-weight: 600; color: var(--muted); box-shadow: var(--shadow-sm);
      }
      .badge-dot { width: 7px; height: 7px; border-radius: 50%; background: #16a34a; box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.15); }
      .sub { margin: 8px 0 0; color: var(--muted); font-size: 0.92rem; }
      .metric { display: flex; flex-direction: column; gap: 6px; align-items: flex-end; }
      .metric-label { font-size: 0.7rem; font-weight: 600; color: var(--faint); text-transform: uppercase; letter-spacing: 0.06em; }

      /* Toolbar */
      .toolbar {
        display: flex; flex-wrap: wrap; align-items: flex-end; gap: 14px;
        background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
        padding: 16px 18px; box-shadow: var(--shadow); margin-bottom: 24px;
      }
      .field { display: flex; flex-direction: column; gap: 6px; }
      .field > label { font-size: 0.7rem; font-weight: 600; color: var(--faint); text-transform: uppercase; letter-spacing: 0.06em; }
      .field input {
        font: inherit; font-size: 0.9rem; padding: 9px 12px; border: 1px solid var(--line);
        border-radius: 10px; background: #fff; color: var(--ink); min-height: 40px;
        transition: border-color 0.15s, box-shadow 0.15s;
      }
      .field input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15); }
      .seg { display: inline-flex; background: #eef1f5; border-radius: 10px; padding: 3px; gap: 2px; }
      .seg button {
        font: inherit; font-size: 0.85rem; font-weight: 600; border: 0; background: transparent;
        color: var(--muted); padding: 7px 16px; border-radius: 8px; cursor: pointer;
        transition: background 0.15s, color 0.15s, box-shadow 0.15s;
      }
      .seg button:hover { color: var(--ink); }
      .seg button.is-active { background: #fff; color: var(--navy); box-shadow: var(--shadow-sm); }
      .btn-apply {
        font: inherit; font-size: 0.9rem; font-weight: 600; padding: 10px 20px; min-height: 40px;
        border: 0; border-radius: 10px; background: var(--navy); color: #fff; cursor: pointer;
        transition: background 0.15s, transform 0.05s;
      }
      .btn-apply:hover { background: #163a5f; }
      .btn-apply:active { transform: translateY(1px); }
      .status { color: var(--faint); font-size: 0.85rem; align-self: center; min-width: 60px; }

      /* KPI cards */
      .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px; margin-bottom: 24px; }
      .kpi {
        position: relative; overflow: hidden; background: var(--card); border: 1px solid var(--line);
        border-radius: var(--radius); padding: 20px 22px; box-shadow: var(--shadow);
      }
      .kpi::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--c, var(--accent)); }
      .kpi-top { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
      .kpi-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--c, var(--accent)); }
      .kpi-label { font-size: 0.78rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
      .kpi-num { font-size: 2.2rem; font-weight: 700; color: var(--navy); line-height: 1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
      .kpi-meta { margin-top: 8px; font-size: 0.85rem; color: var(--muted); }
      .kpi-meta strong { color: var(--ink); font-weight: 700; }
      .kpi-empty { color: var(--muted); grid-column: 1 / -1; }

      /* Chart cards */
      .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px 24px 24px; box-shadow: var(--shadow); }
      .charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 20px; }
      .card-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 6px; }
      .ch-title { display: flex; align-items: center; gap: 9px; }
      .ch-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
      .card-head h2 { margin: 0; font-size: 1.08rem; font-weight: 650; color: var(--navy); letter-spacing: -0.01em; }
      .ch-meta { color: var(--muted); font-size: 0.84rem; }
      .ch-meta strong { color: var(--ink); font-weight: 700; font-variant-numeric: tabular-nums; }
      .canvas-holder { position: relative; height: 260px; margin-top: 14px; }
      .empty { text-align: center; color: var(--muted); padding: 48px 0; font-size: 0.92rem; }

      @media (max-width: 640px) {
        .page { padding: 28px 16px 60px; }
        .page-head { flex-direction: column; }
        .metric { align-items: flex-start; }
        .toolbar { gap: 12px; }
        .field, .field input { width: 100%; }
        .charts { grid-template-columns: 1fr; }
        .canvas-holder { height: 240px; }
      }
    </style>
  </body>
</html>
