---
// Internal analytics dashboard. Access is gated by functions/_middleware.ts
// (HTTP Basic Auth: admin / ADMIN_PASSWORD). Standalone — it deliberately does
// not use Base.astro. Data comes from /api/stats, which the browser calls with
// the same Basic Auth credentials. Shows, for every event type, both total
// (non-unique) and unique (by IP per day) counts over time.
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Estadísticas — Admin</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js" defer></script>
  </head>
  <body>
    <main class="wrap">
      <header class="head">
        <h1>Estadísticas de eventos</h1>
        <p class="sub">tranquilidadlegal.cl · eventos registrados (bots excluidos)</p>
      </header>

      <form id="filters" class="filters">
        <label>Desde<input type="date" id="from" name="from" /></label>
        <label>Hasta<input type="date" id="to" name="to" /></label>
        <label>
          Agrupar por
          <select id="granularity" name="granularity">
            <option value="day">Día</option>
            <option value="week">Semana</option>
            <option value="month">Mes</option>
          </select>
        </label>
        <button type="submit">Aplicar</button>
      </form>

      <section class="summary">
        <table id="summary-table">
          <thead>
            <tr><th>Evento</th><th>Total</th><th>Únicas (IP·día)</th></tr>
          </thead>
          <tbody></tbody>
        </table>
      </section>

      <section class="chart-box">
        <h2>Eventos totales</h2>
        <p class="hint">Cuenta cada acción, incluso repetida por la misma persona.</p>
        <div class="canvas-holder"><canvas id="chart-total"></canvas></div>
        <p class="empty" id="empty-total" hidden>Sin datos en este rango.</p>
      </section>

      <section class="chart-box">
        <h2>Eventos únicos</h2>
        <p class="hint">Una sola vez por IP por día, para cada tipo de evento.</p>
        <div class="canvas-holder"><canvas id="chart-unique"></canvas></div>
        <p class="empty" id="empty-unique" hidden>Sin datos en este rango.</p>
      </section>

      <p class="status" id="status"></p>
    </main>

    <script is:inline>
      (function () {
        const $ = (id) => document.getElementById(id);
        const fmtNum = (n) => new Intl.NumberFormat('es-CL').format(n);
        const isoLocal = (d) => {
          const z = new Date(d.getTime() - d.getTimezoneOffset() * 60000);
          return z.toISOString().slice(0, 10);
        };

        // Friendly labels + colors per known event type.
        const EVENT_META = {
          page_view: { label: 'Vistas de página', color: '#0e2a47' },
          whatsapp_btn_click: { label: 'Clics WhatsApp', color: '#25d366' },
          contact_info_click: { label: 'Clics datos de contacto', color: '#c9a864' },
        };
        const FALLBACK = ['#8a6d3b', '#5b7c99', '#a0522d', '#556b2f', '#6a5acd', '#b8553a'];
        const meta = (type, i) =>
          EVENT_META[type] || { label: type, color: FALLBACK[i % FALLBACK.length] };

        // Default range: last 30 days.
        const today = new Date();
        const past = new Date(today.getTime() - 29 * 86400000);
        $('from').value = isoLocal(past);
        $('to').value = isoLocal(today);

        let totalChart = null;
        let uniqueChart = null;

        async function load() {
          const from = $('from').value;
          const to = $('to').value;
          const granularity = $('granularity').value;
          $('status').textContent = 'Cargando…';
          let data;
          try {
            const res = await fetch(
              `/api/stats?from=${from}&to=${to}&granularity=${granularity}`,
              { headers: { Accept: 'application/json' } }
            );
            if (!res.ok) throw new Error('HTTP ' + res.status);
            data = await res.json();
          } catch (err) {
            $('status').textContent = 'Error al cargar datos: ' + err.message;
            return;
          }
          $('status').textContent = '';
          render(data);
        }

        function buildDatasets(data, kind) {
          return data.eventTypes.map((t, i) => {
            const m = meta(t, i);
            return {
              label: m.label,
              data: (data.series[t] && data.series[t][kind]) || [],
              borderColor: m.color,
              backgroundColor: m.color + '22',
              tension: 0.25,
              fill: false,
              pointRadius: 2,
              borderWidth: 2,
            };
          });
        }

        function drawChart(existing, canvasId, emptyId, data, kind) {
          const hasData = data.periods.length > 0 && data.eventTypes.length > 0;
          const canvas = $(canvasId);
          $(emptyId).hidden = hasData;
          canvas.style.display = hasData ? '' : 'none';
          if (!hasData) {
            if (existing) { existing.destroy(); }
            return null;
          }
          const cfg = {
            type: 'line',
            data: { labels: data.periods, datasets: buildDatasets(data, kind) },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              interaction: { mode: 'index', intersect: false },
              scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
              plugins: { legend: { position: 'top' } },
            },
          };
          if (existing) {
            existing.data = cfg.data;
            existing.update();
            return existing;
          }
          return new Chart(canvas.getContext('2d'), cfg);
        }

        function render(data) {
          // Summary table
          const tbody = document.querySelector('#summary-table tbody');
          if (!data.eventTypes.length) {
            tbody.innerHTML =
              '<tr><td colspan="3" class="muted">Sin eventos en este rango.</td></tr>';
          } else {
            tbody.innerHTML = data.eventTypes
              .map((t, i) => {
                const m = meta(t, i);
                const tot = data.totals[t] || { total: 0, unique: 0 };
                return `<tr>
                  <td><span class="dot" style="background:${m.color}"></span>${m.label}</td>
                  <td>${fmtNum(tot.total)}</td>
                  <td>${fmtNum(tot.unique)}</td>
                </tr>`;
              })
              .join('');
          }

          totalChart = drawChart(totalChart, 'chart-total', 'empty-total', data, 'total');
          uniqueChart = drawChart(uniqueChart, 'chart-unique', 'empty-unique', data, 'unique');
        }

        $('filters').addEventListener('submit', (e) => {
          e.preventDefault();
          load();
        });

        function start() {
          if (window.Chart) load();
          else setTimeout(start, 50);
        }
        start();
      })();
    </script>

    <style>
      :root {
        --navy: #0e2a47;
        --gold: #c9a864;
        --cream: #fbf7eb;
        --border: #e2dcc9;
        --muted: #6b6b6b;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--cream);
        color: #1a1a1a;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.5;
      }
      .wrap { max-width: 1000px; margin: 0 auto; padding: 32px 24px 64px; }
      .head h1 { margin: 0 0 4px; color: var(--navy); font-size: 1.7rem; }
      .sub { margin: 0 0 24px; color: var(--muted); font-size: 0.9rem; }

      .filters {
        display: flex; flex-wrap: wrap; align-items: end; gap: 16px;
        background: #fff; border: 1px solid var(--border);
        padding: 18px; border-radius: 8px; margin-bottom: 24px;
      }
      .filters label {
        display: flex; flex-direction: column; gap: 4px;
        font-size: 0.78rem; font-weight: 600; color: var(--muted);
        text-transform: uppercase; letter-spacing: 0.04em;
      }
      .filters input, .filters select {
        font: inherit; padding: 9px 10px; border: 1px solid var(--border);
        border-radius: 6px; background: #fff; color: #1a1a1a;
      }
      .filters button {
        font: inherit; font-weight: 600; padding: 10px 22px; border: 0;
        border-radius: 6px; background: var(--navy); color: var(--cream); cursor: pointer;
      }
      .filters button:hover { background: #14375c; }

      .summary {
        background: #fff; border: 1px solid var(--border);
        border-radius: 8px; overflow: hidden; margin-bottom: 24px;
      }
      table { width: 100%; border-collapse: collapse; font-size: 0.94rem; }
      th, td { padding: 11px 16px; text-align: left; border-bottom: 1px solid var(--border); }
      th { background: #faf7ee; color: var(--navy); font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.06em; }
      tbody tr:last-child td { border-bottom: 0; }
      td:nth-child(2), td:nth-child(3), th:nth-child(2), th:nth-child(3) { text-align: right; font-variant-numeric: tabular-nums; }
      .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 8px; vertical-align: baseline; }
      .muted { color: var(--muted); text-align: center; }

      .chart-box {
        background: #fff; border: 1px solid var(--border);
        border-radius: 8px; padding: 20px; margin-bottom: 24px;
      }
      .chart-box h2 { margin: 0 0 2px; color: var(--navy); font-size: 1.1rem; }
      .hint { margin: 0 0 14px; color: var(--muted); font-size: 0.84rem; }
      .canvas-holder { position: relative; height: 300px; }
      .empty { text-align: center; color: var(--muted); padding: 40px 0; }

      .status { color: var(--muted); font-size: 0.88rem; margin-top: 8px; min-height: 1.2em; }

      @media (max-width: 640px) {
        .canvas-holder { height: 240px; }
      }
    </style>
  </body>
</html>
