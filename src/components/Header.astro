---
import { navItems, site, whatsappLink, path } from '../data/site';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const currentPath = (Astro.url.pathname.replace(/\/$/, '') || '/').replace(base, '') || '/';
---

<header class="site-header">
  <div class="container header-inner">
    <a href={path('/')} class="brand" aria-label="Inicio">
      <span class="brand-mark">NV</span>
      <span class="brand-text">
        <span class="brand-name">Natalia Vallejos</span>
        <span class="brand-role">Abogada · Derecho de Familia</span>
      </span>
    </a>

    <nav class="primary-nav" aria-label="Principal">
      <ul>
        {navItems.map((item) => (
          <li>
            <a
              href={path(item.href)}
              class={currentPath === item.href.replace(/\/$/, '') || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'active' : ''}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button class="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-nav">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Móvil">
    <ul>
      {navItems.map((item) => (
        <li><a href={path(item.href)}>{item.label}</a></li>
      ))}
      <li>
        <a class="btn btn-gold" href={whatsappLink()} target="_blank" rel="noopener">
          Consulta por WhatsApp
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--navy);
    color: var(--cream);
    border-bottom: 1px solid rgba(201, 168, 100, 0.2);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-block: 18px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
    color: var(--cream);
  }

  .brand-mark {
    width: 54px;
    height: 54px;
    border: 1px solid var(--gold);
    background: transparent;
    color: var(--gold);
    font-family: var(--serif);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    gap: 4px;
  }

  .brand-name {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--cream);
    letter-spacing: 0.005em;
  }

  .brand-role {
    font-family: var(--sans);
    font-size: 0.7rem;
    color: var(--gold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .primary-nav {
    margin-left: auto;
  }

  .primary-nav ul {
    display: flex;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .primary-nav a {
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--cream);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding-block: 6px;
    border-bottom: 2px solid transparent;
  }

  .primary-nav a:hover {
    color: var(--gold);
  }

  .primary-nav a.active {
    color: var(--cream);
    border-bottom-color: var(--gold);
  }

  .nav-toggle {
    display: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 10px;
    margin-left: auto;
    flex-direction: column;
    gap: 5px;
  }

  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--gold);
    transition: transform 200ms ease, opacity 200ms ease;
  }

  .mobile-nav {
    display: none;
    border-top: 1px solid rgba(201, 168, 100, 0.2);
    background: var(--navy);
    padding: 16px 24px 24px;
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-nav a {
    display: block;
    padding: 14px 8px;
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--cream);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(201, 168, 100, 0.15);
  }

  .mobile-nav a.btn {
    margin-top: 16px;
    text-align: center;
    justify-content: center;
  }

  .mobile-nav.is-open {
    display: block;
  }

  @media (max-width: 1100px) {
    .primary-nav ul { gap: 22px; }
    .primary-nav a { font-size: 0.74rem; letter-spacing: 0.14em; }
  }

  @media (max-width: 980px) {
    .primary-nav { display: none; }
    .nav-toggle { display: flex; }
  }

  @media (max-width: 480px) {
    .brand-name { font-size: 1.25rem; }
    .brand-role { font-size: 0.62rem; letter-spacing: 0.18em; }
    .brand-mark { width: 46px; height: 46px; font-size: 1.35rem; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    if (!mobileNav) return;
    const isOpen = mobileNav.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
</script>
